{
  "name": "study-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "predev": "node scripts/pdf-assets.mjs",
    "prebuild": "node scripts/pdf-assets.mjs",
    "dev:desktop": "node scripts/pdf-assets.mjs && vite --mode desktop --port 1420 --strictPort --host 127.0.0.1",
    "build:desktop": "node scripts/pdf-assets.mjs && tsc --noEmit && vite build --mode desktop",
    "desktop": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "test:desktop": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:desktop:integration": "cargo build --manifest-path src-tauri/Cargo.toml --no-default-features --example storage_bridge --locked && vitest run tests-desktop/storage.test.ts",
    "test:desktop:e2e": "playwright test --config playwright.desktop.config.ts",
    "test:release": "node --test tests-desktop/update-manifest.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.7",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.0.0"
  }
}
