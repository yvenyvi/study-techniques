{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/(.*)", "destination": "/app.html" },
    { "source": "/library/:path*", "destination": "/app.html" },
    { "source": "/courses/:path*", "destination": "/app.html" },
    { "source": "/study/:path*", "destination": "/app.html" },
    { "source": "/reviewers/:path*", "destination": "/app.html" },
    { "source": "/goals/:path*", "destination": "/app.html" },
    { "source": "/settings/:path*", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
